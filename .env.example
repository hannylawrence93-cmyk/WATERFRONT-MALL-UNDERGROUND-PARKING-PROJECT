# Copy this file to .env and fill in your own values.
# .env is already excluded in .gitignore - never commit real credentials.
#
# Leave MPESA_CONSUMER_KEY and MPESA_CONSUMER_SECRET blank to keep the
# app running with SIMULATED M-Pesa payments (no setup needed at all -
# this is the default and is perfectly fine for grading/demo purposes).
#
# To enable REAL M-Pesa Daraja sandbox payments:
#   1. Create an account at https://developer.safaricom.co.ke
#   2. Create an app using the "Lipa Na M-Pesa Sandbox" product
#   3. Copy its Consumer Key and Consumer Secret below
#   4. Run `ngrok http 5000` and copy the https URL it gives you
#   5. Set MPESA_CALLBACK_URL below to that URL + /mpesa/callback
#      e.g. https://abcd1234.ngrok-free.app/mpesa/callback

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# These two are Safaricom's public SANDBOX test values - safe to leave
# as-is unless Safaricom gives you different ones for your app.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Must be a public HTTPS URL Safaricom's servers can reach - your ngrok
# URL + /mpesa/callback. Leave blank to keep M-Pesa simulated.
MPESA_CALLBACK_URL=
